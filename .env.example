# Copy to .env (git-ignored). Defaults work with `supabase start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: email for the OpenAlex / Crossref "polite pool" (faster, more reliable).
SCHOLARLY_MAILTO=

# Embedding provider. Only qwen3 (local) is implemented today.
EMBEDDING_PROVIDER=qwen3

# Free key from https://openalex.org (needed since anonymous use shares a tiny per-IP daily budget).
OPENALEX_API_KEY=

# Roam backend API: graph name and a graph API token (Roam: Settings > Graph > API tokens).
ROAM_GRAPH=
ROAM_API_TOKEN=
